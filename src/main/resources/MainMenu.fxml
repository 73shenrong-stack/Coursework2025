<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.comp2042.MainMenuController"
      alignment="CENTER"
      spacing="25"
      prefWidth="500" prefHeight="600"
      styleClass="main-menu-container">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Label text="TETRIS JFX" styleClass="game-title"/>

    <Label text="Select Game Mode" styleClass="mode-label"/>

    <!-- Game Mode Buttons -->
    <VBox alignment="CENTER" spacing="15" styleClass="button-container">

        <!-- Blitz Mode Button -->
        <Button fx:id="blitzModeButton" onAction="#onBlitzMode" styleClass="mode-card" prefWidth="400" maxHeight="90">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="⚡" styleClass="mode-icon"/>
                    <VBox spacing="5">
                        <Label text="BLITZ MODE" styleClass="mode-title"/>
                        <Label text="Score as high as possible in two minutes" styleClass="mode-description"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

        <!-- 40 Lines Mode Button -->
        <Button fx:id="fortyLinesModeButton" onAction="#onFortyLinesMode" styleClass="mode-card" prefWidth="400" maxHeight="90">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="🎯" styleClass="mode-icon"/>
                    <VBox spacing="5">
                        <Label text="FORTY LINES" styleClass="mode-title"/>
                        <Label text="Clear forty lines as fast as you can" styleClass="mode-description"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

        <!-- Zen Mode Button -->
        <Button fx:id="zenModeButton" onAction="#onZenMode" styleClass="mode-card" prefWidth="400" maxHeight="90">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="🧘" styleClass="mode-icon"/>
                    <VBox spacing="5">
                        <Label text="ZEN MODE" styleClass="mode-title"/>
                        <Label text="Relax and play without pressure" styleClass="mode-description"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>
    </VBox>

    <Region VBox.vgrow="SOMETIMES" minHeight="20"/>
    <Button fx:id="exitButton" text="Quit Game" onAction="#onExit" prefWidth="300" styleClass="quit-button"/>

</VBox>