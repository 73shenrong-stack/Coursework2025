<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.view.GameViewController">

    <BorderPane>
        <center>
            <HBox alignment="CENTER" spacing="40">
                <VBox alignment="CENTER" spacing="30" prefWidth="250" minWidth="200">
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="HOLD" styleClass="section-title"/>
                        <Pane styleClass="brick-container" prefWidth="120" prefHeight="100" maxWidth="120" maxHeight="100">
                            <GridPane fx:id="HoldBrickPanel" hgap="1" vgap="1" alignment="CENTER" layoutX="20" layoutY="10"/>
                        </Pane>
                    </VBox>

                    <VBox alignment="CENTER" spacing="15" styleClass="stats-box">
                        <VBox alignment="CENTER">
                            <Label text="SCORE" styleClass="stat-label"/>
                            <Label fx:id="scoreLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox alignment="CENTER">
                            <Label text="LINES" styleClass="stat-label"/>
                            <Label fx:id="linesLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox alignment="CENTER">
                            <Label text="TIME" styleClass="stat-label"/>
                            <Label fx:id="modeTimerLabel" text="0:00" styleClass="stat-value"/>
                        </VBox>
                    </VBox>
                </VBox>

                <StackPane>
                    <BorderPane fx:id="gameBoard" styleClass="gameBoard" maxWidth="220" maxHeight="490">
                        <center>
                            <GridPane fx:id="gamePanel" hgap="1" vgap="1" alignment="CENTER"/>
                        </center>
                    </BorderPane>

                    <Pane fx:id="brickContainerPane" maxWidth="270" maxHeight="520" mouseTransparent="true">
                        <GridPane fx:id="brickPanel" hgap="1" vgap="1"/>
                    </Pane>

                    <Group fx:id="groupNotification" styleClass="bonusStyle" />
                </StackPane>

                <VBox alignment="CENTER" spacing="30" prefWidth="250" minWidth="200">
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="NEXT" styleClass="section-title"/>
                        <Pane styleClass="brick-container" prefWidth="120" prefHeight="100" maxWidth="120" maxHeight="100">
                            <GridPane fx:id="nextBrickPanel" hgap="1" vgap="1" alignment="CENTER" layoutX="20" layoutY="10"/>
                        </Pane>
                    </VBox>
                    <VBox fx:id="nextBrickContainer" />
                </VBox>
            </HBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="40" prefHeight="90" styleClass="modern-controls-bar">

                <!-- MOVE -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="← →" styleClass="key-wide"/>
                    <Label text="Move" styleClass="control-label"/>
                </VBox>

                <!-- ROTATE -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="↑" styleClass="key-wide"/>
                    <Label text="Rotate" styleClass="control-label"/>
                </VBox>

                <!-- SOFT DROP -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="↓" styleClass="key-wide"/>
                    <Label text="SOFT DROP" styleClass="control-label"/>
                </VBox>

                <!-- HARD DROP -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="SPACE" styleClass="key-wide"/>
                    <Label text="HARD DROP" styleClass="control-label"/>
                </VBox>

                <!-- HOLD -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="C" styleClass="key-wide"/>
                    <Label text="HOLD" styleClass="control-label"/>
                </VBox>

                <!-- RESTART -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="N" styleClass="key-wide"/>
                    <Label text="RESTART" styleClass="control-label"/>
                </VBox>

                <!-- PAUSE -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="P" styleClass="key-wide"/>
                    <Label text="PAUSE" styleClass="control-label"/>
                </VBox>

                <!-- MAIN MENU -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="M" styleClass="key-wide"/>
                    <Label text="MAIN MENU" styleClass="control-label"/>
                </VBox>

                <!-- FULL SCREEN -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="F11" styleClass="key-wide"/>
                    <Label text="FULL SCREEN" styleClass="control-label"/>
                </VBox>

            </HBox>
        </bottom>
    </BorderPane>

    <StackPane fx:id="pauseOverlay" styleClass="overlay-pane" visible="false">
        <VBox alignment="CENTER" spacing="10">
            <Label text="PAUSED" styleClass="overlay-title"/>
            <Label text="Press 'P' to Resume" styleClass="overlay-subtext"/>
            <Label text="Press 'M' for Menu" styleClass="overlay-subtext"/>
        </VBox>
    </StackPane>

    <StackPane fx:id="gameOverOverlay" styleClass="overlay-pane" visible="false">
        <VBox alignment="CENTER" spacing="10">
            <Label text="GAME OVER" styleClass="overlay-title"/>
            <Label text="Press 'N' for New Game" styleClass="overlay-subtext"/>
            <Label text="Press 'M' for Menu" styleClass="overlay-subtext"/>
        </VBox>
    </StackPane>
</StackPane>